# Copy this file to .env and fill in your real values. Never commit .env itself.

# Get a free key at https://serpapi.com (free tier ~100-250 searches/month, no card required at signup)
SERPAPI_KEY=your_serpapi_key_here

# Where the SQLite database file will live
DATABASE_URL=sqlite:///./visualfind.db

# Max upload size in MB (keep small - free tier quota is precious)
MAX_UPLOAD_MB=8

# --- Security ---
# Comma-separated list of origins allowed to call this API from a browser.
# MUST be set to your real deployed frontend URL in production - the
# default below only allows local dev. Do not set this to "*" unless you
# fully understand the tradeoff.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute, per client IP, enforced on /api/search/image and all
# /api/ai/* routes (the ones that spend SerpApi/Gemini quota).
RATE_LIMIT_PER_MINUTE=20

# --- Cloudinary (used to host the uploaded image at a public URL for SerpApi) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Live pricing engine ---
# How long (seconds) cached Shopping/search results are reused before re-querying SerpApi.
CACHE_TTL_SECONDS=1800

# Tier-3 price fallback: best-effort fetch of the trusted product page itself to read
# structured (JSON-LD) price data when Google Shopping has no matching offer.
# Safe to disable if you'd rather never make an outbound request to the retailer.
ENABLE_PAGE_METADATA_FALLBACK=true

# Two-letter country / language hints passed to SerpApi's Google Shopping engine.
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en

# --- AI Shopping Assistant (Gemini) ---
# Get a free key at https://aistudio.google.com/apikey
# Optional: everything above this line keeps working with zero AI config.
# Leave blank to run VisualFind without the AI Shopping Assistant.
GEMINI_API_KEY=your_gemini_api_key_here
# Google restricts newer API keys/projects from calling older dated model
# names (e.g. gemini-2.0-flash, gemini-2.5-flash) even though they still
# appear in the ListModels response. Using the "-latest" alias avoids this
# since it always resolves to whatever Google currently recommends.
# If you still get a 404, run:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# and pick a model whose supportedGenerationMethods includes generateContent.
GEMINI_MODEL=gemini-flash-latest

# --- Auth (JWT) ---
# Long random secret used to sign login tokens. MUST be changed for any
# real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Outgoing email (password reset links) ---
# Leave SMTP_HOST empty to run in dev mode: reset links are written to the
# server logs instead of being emailed. To send real emails with Gmail, use
# smtp.gmail.com / 587 and a 16-character "App Password" (not your normal
# Gmail password) - generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@visualfind.app
SMTP_FROM_NAME=VisualFind

# Base URL of the deployed frontend - used to build the password reset link
# that gets emailed to the user. No trailing slash.
FRONTEND_BASE_URL=http://localhost:5173

# --- Internal Product Index: embedding backend ---
# See README's "Embedding Backends" section and
# app/services/product_index/embedding_backends/. All optional - defaults
# below match the built-in dependency-light default backend.
# PRODUCT_INDEX_EMBEDDING_ENABLED=true
# PRODUCT_INDEX_EMBEDDING_BACKEND=perceptual-hash-v1
# PRODUCT_INDEX_EMBEDDING_TIMEOUT_SECONDS=4.0
#
# To use real CLIP embeddings instead (requires
# `pip install -r requirements-openclip.txt` first):
# PRODUCT_INDEX_EMBEDDING_BACKEND=open-clip-vit-b-32
# PRODUCT_INDEX_OPENCLIP_MODEL_NAME=ViT-B-32
# PRODUCT_INDEX_OPENCLIP_PRETRAINED=openai
# PRODUCT_INDEX_OPENCLIP_DEVICE=cpu
